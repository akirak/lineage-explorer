{
  "name": "openlineage-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sample": "duckdb openlineage.duckdb < data/build-db.sql",
    "validate": "tsx scripts/validate.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@duckdb/node-api": "^1.5.6-r.1",
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-router": "^1.170.45",
    "@xyflow/react": "^12.12.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
