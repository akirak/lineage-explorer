{
  "name": "openlineage-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sample": "duckdb openlineage.duckdb < data/build-db.sql",
    "validate": "tsx scripts/validate.ts",
    "dev": "vite dev",
    "build": "vite build",
    "build:cloudflare": "tsx scripts/build-snapshot.ts && vite build --mode cloudflare && tsx scripts/check-cloudflare-assets.ts",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "start": "vite preview --port 3001",
    "test:deployment": "tsx --test scripts/cloudflare.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@dagrejs/dagre": "^3.1.1",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@duckdb/node-api": "1.5.6-r.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
